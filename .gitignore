# Secrets: only .env.example is committed
.env

# Raw downloaded data is never committed (hundreds of MB, and the
# publishers are the authoritative source - see data/README.md)
# (data/raw/* rather than data/raw/ - git cannot re-include a file whose
# parent directory is itself excluded, so the .gitkeep would vanish)
data/raw/*
!data/raw/.gitkeep

# Local teaching notes
notes/

# Note on docs/figures/*.png: those ARE committed, deliberately. They are a few
# hundred KB in total, they are regenerated by scripts/make_figures.py, and a
# README that embeds images GitHub cannot serve shows broken icons to every
# reader. Generated output is normally excluded; rendered documentation that
# the README depends on is the exception.

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
