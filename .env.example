# Copy to .env and set a local password. .env is gitignored.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=employer_intel
POSTGRES_USER=employer_intel
POSTGRES_PASSWORD=set_a_local_password_here

# Path inside the container where data/raw is mounted read-only.
# Used by server-side COPY in the raw load step.
CONTAINER_RAW_DIR=/data/raw
